# Required: obtain this from @BotFather. Never publish the real token.
BOT_TOKEN=123456:REPLACE_WITH_YOUR_REAL_TOKEN

# Optional: comma-separated numeric Telegram user IDs.
# Leave blank if you do not need admin-only commands yet.
ADMIN_IDS=

MAX_FILE_MB=20
MAX_PIXELS=40000000
CONCURRENCY=3
LOG_LEVEL=INFO
DB_PATH=bot_data.sqlite3
